{
  "Discord Prefix Command": {
    "scope": "typescript",
    "prefix": "prefixCommand",
    "body": [
      "import type { PrefixCommand } from '@/types/commands'",
      "",
      "export default {",
      "  async execute(message) {",
      "    $0",
      "  }",
      "} satisfies PrefixCommand"
    ],
    "description": "Discord prefix command"
  },
  "Discord Prefix Command with Subcommands": {
    "scope": "typescript",
    "prefix": "prefixSubCommand",
    "body": [
      "import type { PrefixCommand } from '@/types/commands'",
      "",
      "export default {",
      "  async execute(message, args) {",
      "    const sub = args[0]?.toLowerCase()",
      "",
      "    if (sub === '$1') {",
      "      $0",
      "    }",
      "  }",
      "} satisfies PrefixCommand"
    ],
    "description": "Discord prefix command with subcommands"
  },
  "Discord Slash Command": {
    "scope": "typescript",
    "prefix": "slashCommand",
    "body": [
      "import { SlashCommandBuilder } from 'discord.js'",
      "import type { SlashCommand } from '@/types/commands'",
      "",
      "export default {",
      "  data: new SlashCommandBuilder()",
      "    .setName('$1')",
      "    .setDescription('$2'),",
      "",
      "  async execute(interaction) {",
      "    $0",
      "  }",
      "} satisfies SlashCommand"
    ],
    "description": "Discord slash command"
  },
  "Discord Slash Command with Subcommands": {
    "scope": "typescript",
    "prefix": "slashSubCommand",
    "body": [
      "import { SlashCommandBuilder } from 'discord.js'",
      "import type { SlashCommand } from '@/types/commands'",
      "",
      "export default {",
      "  data: new SlashCommandBuilder()",
      "    .setName('$1')",
      "    .setDescription('$2')",
      "    .addSubcommand(sub =>",
      "      sub",
      "        .setName('$3')",
      "        .setDescription('$4')",
      "    ),",
      "",
      "  async execute(interaction) {",
      "    const sub = interaction.options.getSubcommand()",
      "",
      "    if (sub === '$3') {",
      "      $0",
      "    }",
      "  }",
      "} satisfies SlashCommand"
    ],
    "description": "Discord slash command with subcommands"
  },
  "Discord Context Menu Command": {
    "scope": "typescript",
    "prefix": "contextMenuCommand",
    "body": [
      "import { ContextMenuCommandBuilder, ApplicationCommandType } from 'discord.js'",
      "import type { ContextMenuCommand } from '@/types/commands'",
      "",
      "export default {",
      "  data: new ContextMenuCommandBuilder()",
      "    .setName('$1')",
      "    .setType(ApplicationCommandType.${2|User,Message|}),",
      "",
      "  async execute(interaction, client) {",
      "    ${3|const user = await client.users.fetch(interaction.targetId);,const message = await interaction.channel?.messages.fetch(interaction.targetId);|}",
      "",
      "    $0",
      "  }",
      "} satisfies ContextMenuCommand"
    ],
    "description": "Discord context menu command"
  }
}
